# Build output
/build/
/build-*/
/out/
/DerivedData/
/CMakeFiles/
/CMakeCache.txt
cmake_install.cmake
Makefile
*.o
*.obj

# IDE / editor
.vscode/
.idea/
*.xcuserstate
*.xcworkspace/xcuserdata/
.xcodeproj/xcuserdata/
.cache/
*.swp
.DS_Store

# Dependencies (vendored via submodules)
/third_party/*/  !empty

# FFmpeg LGPL build artifacts (rebuilt from scripts/build-ffmpeg-lgpl-macos.sh).
# The ~150MB of source + binaries should never be committed.
/third_party/ffmpeg-lgpl/
/third_party/ffmpeg-lgpl-build/

# Project-local cache (content-addressed, rebuildable)
**/cache/peaks/
**/cache/thumbs/
**/cache/render/

# Node (notes-graph-kit)
node_modules/

# ImGui runtime layout (regenerated per launch)
imgui.ini

# Agent tooling local state (never commit)
.claude/
.codex/
.cursor/
.zcode/

# OS junk
Thumbs.db

# Local Obsidian notes vault — kept out of the public repo.
/Project Notes/
